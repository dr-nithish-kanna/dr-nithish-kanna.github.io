---
// Cover art for a game. Uses the real screenshot when one exists,
// otherwise a generated placeholder (brand colours + category + title).
import type { Game } from '../lib/games';
import { categoriesOf } from '../lib/games';
import Icon from './Icon.astro';

interface Props { game: Game; eager?: boolean; showTitle?: boolean }
const { game, eager = false, showTitle = true } = Astro.props;

const iconFor: Record<string, Parameters<typeof Icon>[0]['name']> = {
  Typing: 'keyboard', Racing: 'gauge', Casual: 'sparkles', Action: 'rocket', Puzzle: 'layers',
  Platformer: 'layers', Strategy: 'cpu', Adventure: 'globe', Sample: 'code', Word: 'pen',
  Arcade: 'gamepad', Multiplayer: 'chat',
};
const primary = categoriesOf(game)[0];
const icon = iconFor[primary] ?? 'gamepad';

// Deterministic variation per game so placeholders don't all look identical.
let h = 0;
for (const ch of game.slug) h = (h * 31 + ch.charCodeAt(0)) >>> 0;
const gx = 20 + (h % 60);
const gy = 15 + ((h >> 5) % 50);
const angle = (h >> 9) % 360;
const pattern = ['dots', 'grid', 'rings'][(h >> 3) % 3];
const uid = `c-${game.slug}`;
const alt = `${game.title} screenshot`;
---
<div class={`cover cover--${game.image ? game.image_orientation ?? 'landscape' : 'placeholder'}`}>
  {game.image ? (
    game.image_orientation === 'portrait' ? (
      <>
        <img class="cover__backdrop" src={game.image} alt="" aria-hidden="true" loading={eager ? 'eager' : 'lazy'} decoding="async" />
        <img class="cover__img cover__img--contain" src={game.image} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" />
      </>
    ) : (
      <img class="cover__img" src={game.image} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" />
    )
  ) : (
    <>
      <svg class="cover__art" viewBox="0 0 400 250" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
        <defs>
          <radialGradient id={`${uid}-glow`} cx={`${gx}%`} cy={`${gy}%`} r="75%">
            <stop offset="0" stop-color="#06E7FE" stop-opacity="0.55" />
            <stop offset="0.45" stop-color="#3DBCFE" stop-opacity="0.18" />
            <stop offset="1" stop-color="#0A1020" stop-opacity="0" />
          </radialGradient>
          <linearGradient id={`${uid}-base`} gradientTransform={`rotate(${angle} 0.5 0.5)`}>
            <stop offset="0" stop-color="#16213A" />
            <stop offset="1" stop-color="#0A1020" />
          </linearGradient>
          <pattern id={`${uid}-p`} width="20" height="20" patternUnits="userSpaceOnUse">
            {pattern === 'dots' && <circle cx="10" cy="10" r="1.2" fill="#93A4BF" fill-opacity="0.25" />}
            {pattern === 'grid' && <path d="M20 0H0V20" fill="none" stroke="#93A4BF" stroke-opacity="0.12" />}
            {pattern === 'rings' && <circle cx="10" cy="10" r="6" fill="none" stroke="#93A4BF" stroke-opacity="0.12" />}
          </pattern>
        </defs>
        <rect width="400" height="250" fill={`url(#${uid}-base)`} />
        <rect width="400" height="250" fill={`url(#${uid}-p)`} />
        <rect width="400" height="250" fill={`url(#${uid}-glow)`} />
      </svg>
      <div class="cover__label">
        <span class="cover__icon"><Icon name={icon} /></span>
        {showTitle && <span class="cover__title">{game.title}</span>}
        <span class="cover__cat">{game.category}</span>
      </div>
    </>
  )}
</div>
<style>
  .cover { position: relative; aspect-ratio: 16 / 10; overflow: hidden; background: var(--surface-2); }
  .cover__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .cover__img--contain { object-fit: contain; padding-block: 0.5rem; filter: drop-shadow(0 6px 16px rgb(0 0 0 / 0.5)); }
  .cover__backdrop { position: absolute; inset: -10%; width: 120%; height: 120%; object-fit: cover; filter: blur(18px) brightness(0.45) saturate(1.2); }
  .cover__art { position: absolute; inset: 0; width: 100%; height: 100%; }
  .cover__label {
    position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: flex-end;
    padding: 1rem 1.1rem; gap: 0.15rem;
  }
  .cover__icon {
    position: absolute; top: 0.9rem; left: 1rem;
    width: 2.6rem; height: 2.6rem; display: grid; place-items: center;
    border-radius: 0.75rem; background: rgb(6 231 254 / 0.12); color: var(--primary);
    border: 1px solid rgb(34 211 238 / 0.25);
  }
  .cover__icon :global(svg) { width: 1.4rem; height: 1.4rem; }
  .cover__title { font-family: var(--font-display); font-weight: 700; font-size: 1.35rem; line-height: 1.15; color: var(--text); letter-spacing: -0.01em; }
  .cover__cat { font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
</style>
