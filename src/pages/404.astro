---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Page not found" description="This page doesn't exist." noindex>
  <section class="section nf">
    <div class="container">
      <p class="nf__code text-gradient" aria-hidden="true">404</p>
      <h1>Game over for this page.</h1>
      <p class="lead">The page you were looking for doesn't exist or has moved. Try one of these instead.</p>
      <div class="btn-row">
        <a class="btn btn--primary" href="/">Back to home <Icon name="arrow" /></a>
        <a class="btn btn--ghost" href="/games/">Browse games</a>
        <a class="btn btn--ghost" href="/contact/">Contact</a>
      </div>
    </div>
  </section>
</Base>
<style>
  .nf { text-align: left; min-height: 60vh; display: grid; align-items: center; }
  .nf__code { font-family: var(--font-display); font-weight: 700; font-size: clamp(5rem, 18vw, 9rem); line-height: 1; margin: 0 0 1rem; }
</style>
